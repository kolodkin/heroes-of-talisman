#!/bin/bash
set -e

SCRIPT_DIR=$(dirname $(readlink -f $0))
ROOT_DIR=$SCRIPT_DIR/..

cd $ROOT_DIR

# Set environment variable for Playwright single-process mode (needed in containerized environments)
export PLAYWRIGHT_SINGLE_PROCESS=true

echo "=========================================="
echo "Setting up Heroes of Talisman for Claude Code environment..."
echo "=========================================="

# Fix PostgreSQL SSL configuration if needed
if [ -f /etc/postgresql/16/main/postgresql.conf ]; then
    echo ""
    echo "Step 1: Configuring PostgreSQL..."

    # Disable SSL to avoid certificate permission issues
    sed -i 's/ssl = on/ssl = off/' /etc/postgresql/16/main/postgresql.conf 2>/dev/null || true

    # Configure authentication for local postgres user (trust for local socket)
    sed -i 's/local   all             postgres                                peer/local   all             postgres                                trust/' /etc/postgresql/16/main/pg_hba.conf 2>/dev/null || true

    # Configure authentication for TCP connections (md5 password auth)
    sed -i 's/host    all             all             127.0.0.1\/32            scram-sha-256/host    all             all             127.0.0.1\/32            md5/' /etc/postgresql/16/main/pg_hba.conf 2>/dev/null || true

    # Check if postgres is already running
    if pg_isready -h localhost -p 5432 -U postgres >/dev/null 2>&1; then
        echo "  ✓ PostgreSQL is already running"
    else
        echo "  → Starting PostgreSQL service..."
        service postgresql start || echo "  ⚠ Warning: Could not start PostgreSQL service"
        sleep 2
    fi

    # Set postgres user password (only if not already set correctly)
    echo "  → Setting PostgreSQL password..."
    su - postgres -c "psql -c \"ALTER USER postgres PASSWORD 'postgres';\"" >/dev/null 2>&1 || echo "  ⚠ Warning: Could not set postgres password"

    # Restart to apply authentication changes
    echo "  → Restarting PostgreSQL to apply configuration..."
    service postgresql restart >/dev/null 2>&1 || echo "  ⚠ Warning: Could not restart PostgreSQL"
    sleep 2

    if pg_isready -h localhost -p 5432 -U postgres >/dev/null 2>&1; then
        echo "  ✓ PostgreSQL is ready"
    else
        echo "  ✗ PostgreSQL is not responding"
        exit 1
    fi
else
    echo "  ⚠ PostgreSQL config not found, skipping..."
fi

# Start Redis if available
echo ""
echo "Step 2: Starting Redis..."
if command -v redis-server >/dev/null 2>&1; then
    if redis-cli ping >/dev/null 2>&1; then
        echo "  ✓ Redis is already running"
    else
        echo "  → Starting Redis server..."
        redis-server --daemonize yes --port 6379
        sleep 1
        if redis-cli ping >/dev/null 2>&1; then
            echo "  ✓ Redis is ready"
        else
            echo "  ⚠ Warning: Redis failed to start"
        fi
    fi
else
    echo "  ⚠ Warning: Redis is not installed. Some features may not work."
fi

# Run the main setup script with --no-docker flag
echo ""
echo "Step 3: Running main setup script..."
echo "=========================================="
bash "$SCRIPT_DIR/setup" --no-docker

echo ""
echo "=========================================="
echo "✓ Setup complete for Claude Code environment!"
echo "=========================================="
echo ""
echo "You can now:"
echo "  • Run tests: source .venv/bin/activate && pytest"
echo "  • Run e2e tests: npm run e2e"
echo "  • Start server: npm run dev:server"
echo "  • Start frontend: npm run dev"
echo ""
